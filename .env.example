# Neon Postgres connection string (Neon dashboard → Connection details). Needed to save edits.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password for /admin. Pick a long one.
ADMIN_PASSWORD=change-me-to-a-long-password

# Random string (32+ characters) used to sign the login cookie.
# Make one with:  openssl rand -hex 32
SESSION_SECRET=

# Optional: Vercel Blob token for image/CV uploads (Vercel → Storage → Blob). Without it, paste image URLs.
BLOB_READ_WRITE_TOKEN=
